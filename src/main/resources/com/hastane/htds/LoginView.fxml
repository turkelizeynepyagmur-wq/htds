<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hastane.htds.controller.LoginController" style="-fx-background-color: #f4f4f4; -fx-padding: 40;">
    <children>
        <Label text="HTDS Giriş Paneli" textFill="#2c3e50">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>
        
        <VBox spacing="5.0" maxWidth="250.0">
            <Label text="Kullanıcı Adı:" />
            <TextField fx:id="txtKullanici" promptText="Örn: admin" />
        </VBox>
        
        <VBox spacing="5.0" maxWidth="250.0">
            <Label text="Şifre:" />
            <PasswordField fx:id="txtSifre" promptText="Şifreniz" />
        </VBox>
        
        <Button mnemonicParsing="false" onAction="#btnGirisClick" text="Giriş Yap" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-width: 250.0;" />
        
        <Label fx:id="lblHata" textFill="#e74c3c" wrapText="true" />
    </children>
</VBox>
