<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.FlowPane?>

<BorderPane fx:id="rootPane" xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.hastane.htds.controller.DashboardController"
            styleClass="root-pane"
            prefWidth="1024" prefHeight="720">

    <!-- SOL MENÜ (SIDEBAR) -->
    <left>
        <VBox spacing="20" prefWidth="260" styleClass="sidebar" alignment="TOP_CENTER">
            <!-- Logo Başlık -->
            <Label text="%sidebar.app.name" styleClass="logo-label"/>
            
            <Pane prefHeight="10"/>

            <!-- Kullanıcı Bilgileri Paneli -->
            <VBox fx:id="profileBox" spacing="8" styleClass="profile-box" alignment="CENTER" maxWidth="Infinity">
                <Label fx:id="avatarLabel" text="U" styleClass="avatar-label"/>
                <Label fx:id="nameLabel" text="%general.loading" styleClass="user-name-label" wrapText="true" alignment="CENTER"/>
                <Label fx:id="roleLabel" text="%general.loading" styleClass="user-role-badge"/>
                <Label fx:id="deptLabel" text="%general.loading" styleClass="user-dept-label" wrapText="true" alignment="CENTER"/>
            </VBox>

            <Pane prefHeight="10"/>

            <!-- Menü Butonları -->
            <VBox spacing="8" alignment="TOP_LEFT" maxWidth="Infinity">
                <Button fx:id="dashboardBtn" text="%sidebar.dashboard" styleClass="nav-button, nav-button-active" maxWidth="Infinity" onAction="#handleNavClick"/>
                <Button fx:id="arizaBildirBtn" text="%sidebar.report.issue" styleClass="nav-button" maxWidth="Infinity" onAction="#handleNavClick"/>

                <Button fx:id="arizalarBtn" text="%sidebar.records" styleClass="nav-button" maxWidth="Infinity" onAction="#handleNavClick"/>
                <Button fx:id="rehberBtn" text="%sidebar.directory" styleClass="nav-button" maxWidth="Infinity" onAction="#handleNavClick"/>
                <Button fx:id="personelBtn" text="%sidebar.staff.management" styleClass="nav-button" maxWidth="Infinity" onAction="#handleNavClick"/>
            </VBox>

            <!-- Esnek Boşluk (Alttaki çıkış butonunu en alta itmek için) -->
            <VBox VBox.vgrow="ALWAYS"/>

            <!-- Çıkış Butonu -->
            <Button text="%sidebar.logout" styleClass="logout-button" maxWidth="Infinity" onAction="#handleLogout"/>
        </VBox>
    </left>

    <!-- ANA İÇERİK ALANI -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox spacing="24" styleClass="main-content">
                <!-- Üst Hoşgeldiniz Metni -->
                <VBox spacing="4">
                    <Label fx:id="welcomeTitle" text="%dashboard.welcome.title" styleClass="welcome-title"/>
                    <Label text="%dashboard.welcome.subtitle" styleClass="welcome-subtitle"/>
                </VBox>

                <!-- Modern Kart/Afiş -->
                <VBox spacing="8" styleClass="welcome-card">
                    <Label text="%dashboard.banner.title" styleClass="welcome-card-title"/>
                    <Label text="%dashboard.banner.body" 
                           styleClass="welcome-card-body" wrapText="true"/>
                </VBox>

                <!-- İstatistik Kartları Grid (HBox) -->
                <HBox fx:id="statsContainer" spacing="16" alignment="CENTER_LEFT">
                    <!-- Kart 1: Bekleyen Arızalar -->
                    <VBox spacing="4" styleClass="card" HBox.hgrow="ALWAYS" prefWidth="250" onMouseClicked="#handlePendingCardClick">
                        <Label fx:id="pendingTitleLabel" text="%dashboard.pending.title" styleClass="card-title"/>
                        <Label fx:id="pendingCountLabel" text="-" styleClass="card-value"/>
                        <Label text="%dashboard.pending.desc" styleClass="card-desc" style="-fx-text-fill: #f59e0b;"/>
                    </VBox>

                    <!-- Kart 2: İşlemdeki Arızalar -->
                    <VBox spacing="4" styleClass="card" HBox.hgrow="ALWAYS" prefWidth="250" onMouseClicked="#handleInProgressCardClick">
                        <Label fx:id="inProgressTitleLabel" text="%dashboard.in.progress.title" styleClass="card-title"/>
                        <Label fx:id="inProgressCountLabel" text="-" styleClass="card-value"/>
                        <Label text="%dashboard.in.progress.desc" styleClass="card-desc" style="-fx-text-fill: #3b82f6;"/>
                    </VBox>

                    <!-- Kart 3: Çözülen Arızalar -->
                    <VBox spacing="4" styleClass="card" HBox.hgrow="ALWAYS" prefWidth="250" onMouseClicked="#handleSolvedCardClick">
                        <Label fx:id="solvedTitleLabel" text="%dashboard.solved.title" styleClass="card-title"/>
                        <Label fx:id="solvedCountLabel" text="-" styleClass="card-value"/>
                        <Label text="%dashboard.solved.desc" styleClass="card-desc"/>
                    </VBox>
                </HBox>

                <!-- Grafikler ve Aktiviteler Satırı (HBox) -->
                <HBox fx:id="chartsRow" spacing="20" visible="false" managed="false" alignment="TOP_LEFT">
                    <!-- Sol Taraf: Isı Haritası / Pasta Grafik Alanı -->
                    <VBox fx:id="heatmapContainer" spacing="16" styleClass="card" prefWidth="350">
                        <Label fx:id="heatmapTitle" text="%dashboard.heatmap.title" styleClass="section-title"/>
                        <HBox fx:id="chartBox" alignment="CENTER" minHeight="220"/>
                    </VBox>

                    <!-- Sağ Taraf: Son Bildirilen Arızalar -->
                    <VBox fx:id="recentActivityContainer" spacing="12" styleClass="card" prefWidth="400" HBox.hgrow="ALWAYS">
                        <Label text="%dashboard.recent.activities" styleClass="section-title"/>
                        <VBox fx:id="recentActivityBox" spacing="8" />
                    </VBox>
                </HBox>

                <!-- ALT BÖLÜM: HTDS VE DUYURULAR (Sayfanın Boş Kalan Alt Kısmını Zenginleştirme) -->
                <HBox spacing="20" alignment="TOP_LEFT" VBox.vgrow="ALWAYS">
                    <!-- SOL BÖLÜM: ACİL IT & TEKNİK DESTEK KARTI -->
                    <VBox spacing="16" styleClass="card" prefWidth="300" HBox.hgrow="ALWAYS">
                        <Label text="%dashboard.emergency.it.title" styleClass="section-title"/>
                        <VBox spacing="6" style="-fx-padding: 10 0 0 0;">
                            <Label text="%dashboard.emergency.it.techs" style="-fx-text-fill: #0f172a; -fx-font-weight: bold; -fx-font-size: 12px;"/>
                            <Label fx:id="tech1Label" text="%general.loading" style="-fx-text-fill: #64748b; -fx-font-size: 11.5px;"/>
                            <Label fx:id="tech2Label" text="" style="-fx-text-fill: #64748b; -fx-font-size: 11.5px;"/>
                        </VBox>
                    </VBox>

                    <!-- SAG BOLUM: SISTEM DUYURULARI -->
                    <VBox spacing="16" styleClass="card" prefWidth="300" HBox.hgrow="ALWAYS">
                        <Label text="%dashboard.announcements.title" styleClass="section-title"/>
                        
                        <VBox spacing="12">
                            <!-- Duyuru 1 -->
                            <VBox spacing="4" style="-fx-background-color: #fef2f2; -fx-padding: 12; -fx-background-radius: 10; -fx-border-color: #fca5a5; -fx-border-width: 1; -fx-border-radius: 10;">
                                <Label text="%dashboard.announcement1.title" style="-fx-text-fill: #991b1b; -fx-font-weight: bold; -fx-font-size: 12px;"/>
                                <Label text="%dashboard.announcement1.body" 
                                       style="-fx-text-fill: #7f1d1d; -fx-font-size: 11px;" wrapText="true"/>
                            </VBox>
                            
                            <!-- Duyuru 2 -->
                            <VBox spacing="4" style="-fx-background-color: #eff6ff; -fx-padding: 12; -fx-background-radius: 10; -fx-border-color: #bfdbfe; -fx-border-width: 1; -fx-border-radius: 10;">
                                <Label text="%dashboard.announcement2.title" style="-fx-text-fill: #1e40af; -fx-font-weight: bold; -fx-font-size: 12px;"/>
                                <Label text="%dashboard.announcement2.body" 
                                       style="-fx-text-fill: #1e3a8a; -fx-font-size: 11px;" wrapText="true"/>
                            </VBox>

                            <!-- Duyuru 3 -->
                            <VBox spacing="4" style="-fx-background-color: #f0fdf4; -fx-padding: 12; -fx-background-radius: 10; -fx-border-color: #bbf7d0; -fx-border-width: 1; -fx-border-radius: 10;">
                                <Label text="%dashboard.announcement3.title" style="-fx-text-fill: #166534; -fx-font-weight: bold; -fx-font-size: 12px;"/>
                                <Label text="%dashboard.announcement3.body" 
                                       style="-fx-text-fill: #14532d; -fx-font-size: 11px;" wrapText="true"/>
                            </VBox>
                        </VBox>
                    </VBox>
                </HBox>
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
